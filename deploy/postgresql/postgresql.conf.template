# Rendered by render-postgresql-conf.ps1 - YCWL dev cluster
listen_addresses = '__LISTEN_BIND__'
port = __PORT__
max_connections = 100
shared_buffers = 128MB
work_mem = 4MB
maintenance_work_mem = 64MB
wal_level = replica
max_wal_size = 1GB
min_wal_size = 80MB
log_destination = 'stderr'
logging_collector = on
log_directory = '__LOG_DIR__'
log_filename = 'postgresql-%Y-%m-%d.log'
log_line_prefix = '%m [%p] '
timezone = 'UTC'
lc_messages = 'C'
lc_monetary = 'C'
lc_numeric = 'C'
lc_time = 'C'
default_text_search_config = 'pg_catalog.english'
